{
  "name": "obsidian-pdf-studio",
  "version": "0.1.0",
  "description": "Professional live paginated preview, academic citations with Zotero, and peer review for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "BUILD_ENV=production node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pdf",
    "zotero",
    "criticmarkup",
    "academic"
  ],
  "author": "Juan Ignacio Ferber",
  "license": "MIT",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
